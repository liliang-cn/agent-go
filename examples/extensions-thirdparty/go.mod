// A third-party extension lives in its own module and imports agent-go like
// any other dependency. The replace directive points at this checkout so the
// example tracks the framework it sits next to; a real extension drops it and
// requires a released version.
module example.com/budgetgate

go 1.25.0

require github.com/liliang-cn/agent-go/v3 v3.14.0

